---
/**
 * Recall (formerly Daily Drill) lives at recall.devondoes.dev.
 *
 * The app used to be served from this path. It now lives on the hub, because
 * sync authenticates with the devondoes.dev session cookie and this origin
 * cannot send one: served from here it would drill but silently never sync.
 *
 * GitHub Pages cannot send a real redirect, so this is an instant meta refresh
 * plus a script, with a visible link for anyone who lands with both disabled.
 * It points straight at Recall, not the old drill.devondoes.dev host, which redirects again.
 */
const TARGET = 'https://recall.devondoes.dev/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recall has moved</title>
    <meta http-equiv="refresh" content={`0;url=${TARGET}`} />
    <link rel="canonical" href={TARGET} />
    <meta name="robots" content="noindex" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #0b0d12;
        color: #e8e4dc;
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 46ch;
      }
      h1 {
        font-size: 22px;
        margin: 0 0 10px;
      }
      p {
        color: #9aa1ae;
        margin: 0 0 14px;
        font-size: 15px;
      }
      a {
        color: #c86a3a;
      }
      .note {
        font-size: 13px;
        color: #6b7280;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Recall moved</h1>
      <p>
        Recall (formerly Daily Drill) now lives at
        <a href={TARGET}>recall.devondoes.dev</a>. Taking you there now.
      </p>
      <p class="note">
        Progress is stored per site, so this first visit will look empty. If you had
        sync switched on, signing in restores everything. If you didn't, use Settings
        &rarr; Export here and Import there before this page stops being served.
      </p>
    </main>
    <script is:inline define:vars={{ TARGET }}>
      // Replace rather than assign, so Back does not bounce straight back here.
      location.replace(TARGET);
    </script>
  </body>
</html>
