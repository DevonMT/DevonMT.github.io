---
/**
 * Daily Drill moved to drill.devondoes.dev.
 *
 * The app used to be served from this path (public/drill/, copied verbatim into
 * the build). It now lives on the hub, because sync authenticates with the
 * devondoes.dev session cookie and this origin cannot send one — served from
 * here, the app would still drill but would silently never sync, which looks
 * like a bug rather than a misconfiguration.
 *
 * A real page rather than a bare meta refresh: anyone with this bookmarked gets
 * told what happened and where their history went, instead of a blank flash.
 */
const TARGET = 'https://drill.devondoes.dev/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daily Drill has moved</title>
    <meta http-equiv="refresh" content={`3;url=${TARGET}`} />
    <link rel="canonical" href={TARGET} />
    <meta name="robots" content="noindex" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #0b0d12;
        color: #e8e4dc;
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 46ch;
      }
      h1 {
        font-size: 22px;
        margin: 0 0 10px;
      }
      p {
        color: #9aa1ae;
        margin: 0 0 14px;
        font-size: 15px;
      }
      a {
        color: #c86a3a;
      }
      .note {
        font-size: 13px;
        color: #6b7280;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Daily Drill moved</h1>
      <p>
        It now lives at <a href={TARGET}>drill.devondoes.dev</a>. Taking you there in a
        moment.
      </p>
      <p class="note">
        Progress is stored per site, so this first visit will look empty. If you had
        sync switched on, signing in restores everything. If you didn't, use Settings
        &rarr; Export here and Import there before this page stops being served.
      </p>
    </main>
    <script is:inline define:vars={{ TARGET }}>
      // Replace rather than assign, so Back does not bounce straight back here.
      setTimeout(() => location.replace(TARGET), 2500);
    </script>
  </body>
</html>
