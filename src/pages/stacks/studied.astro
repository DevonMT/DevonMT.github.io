---
import PrivateLayout from '../../layouts/PrivateLayout.astro';
// Same import order as the Stacks page (tokens before the theme).
import '../../styles/ds-tokens.css';
import '../../styles/themes/stacks.css';
---

<script>
  // Hub-only, like Stacks itself: the devontroedel.com copy forwards there.
  import { AUTH_MODE, APP_ORIGIN } from '../../lib/privateClient';
  if (AUTH_MODE !== 'access') location.replace(APP_ORIGIN.stacks + '/stacks/studied/');
</script>

<!--
  The target of the phone home-screen shortcut (Chrome menu > Add to Home
  screen, on stacks.devondoes.dev/stacks/studied/). Opening it logs one session
  for the current book, the same as the latest one, and shows what it logged
  with an Undo. It never shows the log form.
-->
<PrivateLayout
  title="I studied"
  description="Private learning tracker."
  label="learn"
  table="learn_sessions"
  intro="Sign in to log a session."
>
<div id="app" hidden>
  <div class="wrap">
    <h1 class="title">Stacks</h1>
    <p id="status" class="status" role="status">Logging…</p>
    <p id="detail" class="detail" hidden></p>
    <div class="actions">
      <button type="button" id="undo" class="btn" hidden>Undo</button>
      <a id="open" class="btn" href="/stacks/" hidden>Open Stacks</a>
    </div>
  </div>
</div>
</PrivateLayout>

<style is:global>
.wrap { max-width: 560px; margin: 0 auto; padding: calc(clamp(13px, 2.4vw, 26px) + 3rem) 1.6rem 4rem; }
.title { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 9vw, 44px); line-height: 1.05; color: var(--color-text); margin: 0 0 1.5rem; }
.status { font-size: 1.3rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.4rem; }
.status.err { color: var(--color-danger); }
.detail { font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-muted); margin: 0 0 1.5rem; }
.actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.75rem 1.5rem; border-radius: var(--radius-xs); border: 1px solid var(--color-border); background: none; color: var(--color-text); font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; text-decoration: none; cursor: pointer; }
.btn:disabled { opacity: 0.5; cursor: default; }
[hidden] { display: none !important; }
</style>

<script>
  import { apiFetch } from '../../lib/privateClient';

  const appEl = document.getElementById('app')!;
  const statusEl = document.getElementById('status')!;
  const detailEl = document.getElementById('detail')!;
  const undoBtn = document.getElementById('undo') as HTMLButtonElement;
  const openLink = document.getElementById('open') as HTMLAnchorElement;

  interface Logged { id: number; loggedAt: string; item: string; minutes: number; skills: string[] }

  function show(text: string, detail = '', err = false) {
    statusEl.textContent = text;
    statusEl.classList.toggle('err', err);
    detailEl.textContent = detail;
    detailEl.hidden = !detail;
  }
  const describe = (s: Logged) => `${s.item} · ${s.minutes} min${s.skills.length ? ' · ' + s.skills.join(', ') : ''}`;

  let started = false;
  async function start() {
    appEl.hidden = false;
    if (started) return;   // the gate can fire authed more than once
    started = true;
    // A restored or reloaded tab carries ?logged=: it already logged, so never POST again.
    if (new URLSearchParams(location.search).has('logged')) {
      show('Already logged', 'This tab already logged a session.');
      openLink.hidden = false;
      return;
    }
    try {
      const res = await apiFetch('/learn/sessions/repeat', { method: 'POST', body: '{}' });
      const s = res.session as Logged;
      // Move this tab off the shortcut URL so a restore/refresh/new tap never reuses it.
      history.replaceState(null, '', `/stacks/studied/?logged=${s.id}`);
      if (res.duplicate) {
        show('Already logged', describe(s));
      } else {
        show('Logged', describe(s));
        undoBtn.hidden = false;
        undoBtn.onclick = async () => {
          undoBtn.disabled = true;
          try {
            await apiFetch(`/learn/sessions/${s.id}`, { method: 'DELETE' });
            show('Undone', 'Nothing was logged.');
            undoBtn.hidden = true;
          } catch (e: any) {
            show('Could not undo', e.message || '', true);
            undoBtn.disabled = false;
          }
        };
      }
    } catch (e: any) {
      if (e.message === 'Unauthorized') { started = false; return; }   // the gate is re-challenging; retry once authed
      // First ever session: there is nothing to repeat, so hand over to the form.
      show(e.message || 'Could not log.', '', true);
      if (/No session to repeat/.test(e.message || '')) openLink.href = '/stacks/#log';
    }
    openLink.hidden = false;
  }

  document.addEventListener('gate:authed', start);
  document.addEventListener('gate:locked', () => { appEl.hidden = true; });
  if (document.documentElement.hasAttribute('data-authed')) start();
</script>
