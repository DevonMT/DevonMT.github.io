---
/**
 * The standalone Playfinder build, served at playfinder.devondoes.dev.
 *
 * Same app component as /games/discover, different chrome: the personal site's
 * nav is replaced with a link back to the hub, because on devondoes.dev those
 * links (/about, /blog, /projects) go nowhere.
 *
 * This page is not linked from the site. It exists to be built and copied to
 * the playfinder container, so it carries noindex — two URLs serving identical
 * content otherwise compete with each other in search.
 */
import '../styles/global.css';
// The estate's shared contract supplies the values; app-palette answers the
// site's own token names with them, under [data-ds="app"] stamped below. The
// site keeps its look at /games/discover, which stamps nothing.
import '../styles/ds-tokens.css';
// Playfinder's own theme (ds/themes, generated): blue-violet ground, cyan,
// Lexend. After the contract, so its values win; /games/discover never loads it.
import '../styles/themes/playfinder.css';
import '../styles/app-palette.css';
import '../styles/ds-chrome.css';
import PlayfinderApp from '../components/PlayfinderApp.astro';
---

<!doctype html>
<html lang="en" data-ds="app">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playfinder — games matched to your taste</title>
    <meta
      name="description"
      content="Build a quick taste profile and get game recommendations, or score any game against your preferences. No account needed."
    />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/emblems/playfinder.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Lexend:wght@500;600;700&display=swap"
    />
    <meta name="theme-color" content="#eaf4ff" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Playfinder — games matched to your taste" />
    <meta
      property="og:description"
      content="Build a quick taste profile and get game recommendations, powered by Claude."
    />
  </head>
  <body>
    <div id="site">
      <div id="bg-grid" aria-hidden="true"><canvas></canvas></div>

      <!-- The shape every app now wears; this page is where it came from.
           No identity and no way out, because Playfinder has no accounts —
           the bar's contract makes both optional for exactly this case. -->
      <header class="ds-bar">
        <a class="ds-mark" href="https://devondoes.dev/">devondoes.dev</a>
        <span class="ds-sep" aria-hidden="true">/</span>
        <span class="ds-here">playfinder</span>
      </header>

      <PlayfinderApp />

    </div><!-- #site -->
    <script is:inline src="/ds-chrome.js" defer></script>
  </body>
</html>

<style is:global>
  /* Neon hexagons (N2, settled 2026-09-13): still, uneven hexagonal prisms
     with glowing top edges in Playfinder's cyan, mint and violet. Replaces the
     component's faint 64px grid on this build only (#site #bg-grid outranks
     its rule); /games/discover keeps the grid. */
  /* Positioned here: the component's own #site/#bg-grid rules are scoped to the
     component and never matched these elements, which live in this page. */
  #site { position: relative; min-height: 100vh; background: var(--color-bg); overflow-x: clip; }
  #site #bg-grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  #site > .ds-bar { position: relative; z-index: 2; }
  #site #bg-grid canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The tiles step back behind the reading column and stay bright at the sides. */
  #site #bg-grid::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent calc(50% - 620px),
      color-mix(in oklab, var(--bg) 80%, transparent) calc(50% - 450px),
      color-mix(in oklab, var(--bg) 80%, transparent) calc(50% + 450px), transparent calc(50% + 620px));
  }
  @media (max-width: 700px) {
    #site #bg-grid::after { background: linear-gradient(to bottom, color-mix(in oklab, var(--bg) 35%, transparent), color-mix(in oklab, var(--bg) 82%, transparent) 40%); }
  }
</style>

<script>
  /* Drawn once, from a seeded generator so the pattern is the same on every
     visit, and again only when the width or the light/dark theme changes. It
     never moves, so it needs nothing from the animation setting. Ported from
     the theme board: the gap rule keeps every hexagon from touching another. */
  const canvas = document.querySelector<HTMLCanvasElement>('#bg-grid canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const root = document.documentElement;
    const darkMq = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => root.dataset.theme === 'dark' || (root.dataset.theme !== 'light' && darkMq.matches);
    const HUES = [195, 150, 285], SEED = 23, GAP = 2.5;
    type Pal = { bg: string; top: number; sideR: number; sideBR: number; sideBL: number; cm: number;
      neon: { l: number; c: number; a: number; blur: number; w: number } };
    const PAL: Record<'light' | 'dark', Pal> = {
      dark: { bg: 'oklab(.13 0 -.012)', top: .24, sideR: .17, sideBR: .14, sideBL: .20, cm: .45, neon: { l: .80, c: 1.9, a: .8, blur: 8, w: 1.3 } },
      light: { bg: 'oklab(.94 0 -.004)', top: .975, sideR: .87, sideBR: .84, sideBL: .90, cm: .12, neon: { l: .60, c: 1.25, a: .30, blur: 5, w: 1.4 } },
    };
    const mulberry = (a: number) => () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
    const lab = (l: number, [a, b]: number[], k = 1, alpha = 1) => `oklab(${l} ${(a * k).toFixed(4)} ${(b * k).toFixed(4)} / ${alpha})`;
    const ANG = [-90, -30, 30, 90, 150, 210].map((d) => d * Math.PI / 180);
    const poly = (pts: number[][]) => { ctx.beginPath(); pts.forEach(([x, y], i) => i ? ctx.lineTo(x, y) : ctx.moveTo(x, y)); ctx.closePath(); };
    function prism(cx: number, cy: number, r: number, e: number, tint: number[], pal: Pal) {
      const base = ANG.map((a) => [cx + r * Math.cos(a), cy + r * Math.sin(a)]);
      const top = base.map(([x, y]) => [x - e * .3, y - e]);
      const side = (i: number, j: number, l: number, k: number) => { ctx.fillStyle = lab(l, tint, k); poly([base[i], base[j], top[j], top[i]]); ctx.fill(); };
      side(1, 2, pal.sideR, .95); side(2, 3, pal.sideBR, .9); side(3, 4, pal.sideBL, 1);
      const g = ctx.createLinearGradient(top[5][0], top[0][1], top[2][0], top[3][1]);
      g.addColorStop(0, lab(Math.min(.99, pal.top + .06), tint, .85));
      g.addColorStop(1, lab(pal.top - .03, tint, 1.05));
      ctx.fillStyle = g; poly(top); ctx.fill();
      const k = pal.neon.c / pal.cm;
      ctx.save();
      ctx.strokeStyle = lab(pal.neon.l, tint, k); ctx.lineWidth = pal.neon.w;
      ctx.shadowColor = lab(pal.neon.l, tint, k, pal.neon.a); ctx.shadowBlur = pal.neon.blur;
      poly(top); ctx.stroke();
      ctx.restore();
    }
    let drawnFor = '';
    function draw() {
      const dpr = Math.min(2, devicePixelRatio || 1), w = canvas!.offsetWidth, h = canvas!.offsetHeight;
      const key = `${w}x${h}@${dpr}:${isDark()}`;
      if (!w || !h || key === drawnFor) return;
      drawnFor = key;
      const pal = PAL[isDark() ? 'dark' : 'light'];
      canvas!.width = Math.round(w * dpr); canvas!.height = Math.round(h * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, w, h);
      const rnd = mulberry(SEED), R = 24, W = Math.sqrt(3) * R, DY = 1.5 * R;
      const cells: { x: number; y: number; gone: boolean; size: number; e: number; hue: number }[] = [];
      for (let k = -1; k * DY < h + R * 2; k++) for (let i = -1; i * W < w + W; i++) {
        cells.push({ x: (k % 2 ? 0 : W / 2) + i * W + (rnd() - .5), y: k * DY + R + (rnd() - .5),
          gone: rnd() < .16, size: .72 + rnd() * .22, e: 1 + rnd() * rnd() * 11, hue: HUES[Math.floor(rnd() * rnd() * HUES.length * 1.4) % HUES.length] });
      }
      cells.sort((a, b) => a.y - b.y || b.x - a.x);
      for (const c of cells) {
        if (c.gone) continue;
        const t = [.14 * Math.cos(c.hue * Math.PI / 180) * pal.cm, .14 * Math.sin(c.hue * Math.PI / 180) * pal.cm];
        /* A prism's outline reaches at most r*0.866 + 0.508e toward a neighbour.
           Keeping that under half the neighbour distance, less the gap, the
           half-pixel jitter and half the glowing outline, means tiles never meet. */
        const room = (Math.sqrt(3) * R - GAP) / 2 - .71 - pal.neon.w / 2;
        const r = Math.min(R * c.size, (room - .508 * c.e) / .866);
        if (r < 4) continue;
        prism(c.x + .15 * c.e, c.y + .5 * c.e, r, c.e, t, pal);
      }
    }
    draw();
    new ResizeObserver(draw).observe(canvas);
    darkMq.addEventListener('change', draw);
    new MutationObserver(draw).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
