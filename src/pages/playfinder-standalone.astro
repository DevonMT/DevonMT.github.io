---
/**
 * The standalone Playfinder build, served at playfinder.devondoes.dev.
 *
 * Same app component as /games/discover, different chrome: the personal site's
 * nav is replaced with a link back to the hub, because on devondoes.dev those
 * links (/about, /blog, /projects) go nowhere.
 *
 * This page is not linked from the site. It exists to be built and copied to
 * the playfinder container, so it carries noindex — two URLs serving identical
 * content otherwise compete with each other in search.
 */
import '../styles/global.css';
// The estate's shared contract supplies the values; app-palette answers the
// site's own token names with them, under [data-ds="app"] stamped below. The
// site keeps its look at /games/discover, which stamps nothing.
import '../styles/ds-tokens.css';
import '../styles/app-palette.css';
import '../styles/ds-chrome.css';
import PlayfinderApp from '../components/PlayfinderApp.astro';
---

<!doctype html>
<html lang="en" data-ds="app">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playfinder — games matched to your taste</title>
    <meta
      name="description"
      content="Build a quick taste profile and get game recommendations, or score any game against your preferences. No account needed."
    />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <meta name="theme-color" content="#f2f4f3" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Playfinder — games matched to your taste" />
    <meta
      property="og:description"
      content="Build a quick taste profile and get game recommendations, powered by Claude."
    />
  </head>
  <body>
    <div id="site">
      <div id="bg-grid" aria-hidden="true"></div>

      <!-- The shape every app now wears; this page is where it came from.
           No identity and no way out, because Playfinder has no accounts —
           the bar's contract makes both optional for exactly this case. -->
      <header class="ds-bar">
        <a class="ds-mark" href="https://devondoes.dev/">devondoes.dev</a>
        <span class="ds-sep" aria-hidden="true">/</span>
        <span class="ds-here">playfinder</span>
      </header>

      <PlayfinderApp />

    </div><!-- #site -->
    <script is:inline src="/ds-chrome.js" defer></script>
  </body>
</html>

<style>
  /* Minimal chrome. The app below brings its own styles; this is only the
     thin line at the top that says where you are and how to get back. */
</style>
